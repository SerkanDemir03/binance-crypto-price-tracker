# ===== Backend =====
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password

# Tablo adı (varsayılan: tbl_binance2)
TABLE_NAME=tbl_binance2

# CORS - frontend origin (virgülle ayırarak birden fazla yazabilirsiniz)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# API URLs (isteğe bağlı)
BINANCE_API_URL=https://api.binance.com/api/v3/ticker/price
COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price

# Binance bölge engeli için proxy (isteğe bağlı). Örn: http://127.0.0.1:7890 veya HTTPS_PROXY
# BINANCE_PROXY=http://127.0.0.1:7890

# Fiyat güncelleme: cron (WebSocket yedek), varsayılan her 1 dakika
UPDATE_INTERVAL=*/1 * * * *
# Varsayılan API: coingecko veya binance.
# Binance kısıtlı bölgelerde (IP engeli, rate limit): DEFAULT_API_PROVIDER=coingecko kullanın.
# Scheduler ve manuel "Güncelle": önce bu provider denenir, başarısız olursa otomatik diğerine geçilir.
DEFAULT_API_PROVIDER=coingecko

# WebSocket (Binance). DEFAULT_API_PROVIDER=coingecko iken Binance WebSocket otomatik atlanır (başlangıç hatası önlenir).
WEBSOCKET_SAVE_INTERVAL=60000
WS_BINANCE_URL=wss://stream.binance.com:9443/ws/!ticker@arr
WS_CONNECT_TIMEOUT_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_RECONNECT_DELAY_MS=5000
WS_MAX_RECONNECT_ATTEMPTS=3

# Binance erişilemiyorsa (IP ban, mobil ağ, bölge engeli): WebSocket'i zorla kapatmak için açın
# SKIP_BINANCE_WEBSOCKET=true

# ===== Frontend (.env veya .env.local) =====
# VITE_API_URL=http://localhost:5000/api
